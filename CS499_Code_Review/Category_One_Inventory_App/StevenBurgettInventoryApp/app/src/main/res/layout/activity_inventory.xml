<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Screen title -->
        <TextView
            android:id="@+id/textInventoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Equipment Inventory"
            android:textAlignment="center"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Instructions -->
        <TextView
            android:id="@+id/textInventoryInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add equipment and monitor available quantities."
            android:textAlignment="center"
            android:textSize="16sp" />

        <!-- Equipment name input -->
        <EditText
            android:id="@+id/editItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Equipment name"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <!-- Quantity input -->
        <EditText
            android:id="@+id/editItemQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Quantity"
            android:inputType="number"
            android:maxLines="1" />

        <!-- Add inventory item -->
        <Button
            android:id="@+id/buttonAddItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Item" />

        <!-- Inventory section -->
        <TextView
            android:id="@+id/textCurrentInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Current Inventory"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!--
            Inventory grid.
            InventoryActivity dynamically adds database records
            below the header row.
        -->
        <TableLayout
            android:id="@+id/tableInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stretchColumns="0">

            <!-- Grid header -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Equipment"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Quantity"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:text="Actions"
                    android:textStyle="bold" />

            </TableRow>

        </TableLayout>

        <!-- Low inventory warning -->
        <TextView
            android:id="@+id/textLowInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="No low inventory warnings."
            android:textStyle="bold" />

        <!-- SMS notification settings -->
        <Button
            android:id="@+id/buttonSmsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SMS Notification Settings" />

        <!-- Logout -->
        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Log Out" />

    </LinearLayout>

</ScrollView>